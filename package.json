{
  "name": "scalelink",
  "version": "1.0.0",
  "description": "Distributed URL shortener with an atomic Redis Lua sliding-window rate limiter",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "jest --runInBand",
    "test:unit": "jest --runInBand tests/unit",
    "smoke": "node scripts/smoke.js",
    "bench": "bash scripts/bench.sh"
  },
  "keywords": [
    "redis",
    "lua",
    "rate-limiting",
    "url-shortener",
    "express"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "nanoid": "^3.3.18",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "supertest": "^7.2.2"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  }
}
