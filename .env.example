# Copy to .env for `npm run dev`. All values shown are the defaults.

PORT=8080
NODE_ENV=development
LOG_LEVEL=info
REDIS_URL=redis://localhost:6379
BASE_URL=http://localhost:8080
INSTANCE_ID=local-dev

# Rate limit: at most N accepted POST /api/shorten per client IP per window.
RATE_LIMIT_WINDOW_SECONDS=10
RATE_LIMIT_MAX_REQUESTS=20

# Whose X-Forwarded-For to believe. UNSET = trust nobody (req.ip is the TCP peer).
# Behind exactly one reverse proxy (as in docker-compose.yml) use 1.
# "true" is refused: it lets any client forge its identity and bypass the limiter.
# TRUST_PROXY=1

# Every Redis command is bounded by this; a stalled Redis becomes a fast 503.
REDIS_COMMAND_TIMEOUT_MS=1000
REDIS_CONNECT_TIMEOUT_MS=2000

# Short-code length (1-32). Leave at 7 unless you are testing collisions.
CODE_LENGTH=7

# Default TTL for new links in seconds; 0/unset = links never expire.
# LINK_DEFAULT_TTL_SECONDS=0
